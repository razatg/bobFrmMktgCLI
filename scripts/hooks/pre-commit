#!/bin/sh
# Bob pre-commit hook: run the core smoke test before every commit.
#
# Wired in per-clone with:
#     git config core.hooksPath scripts/hooks
#
# Keeps the extracted deterministic core and stable CLI contract (metric formulas,
# zero-denominator rule, period-date math, aggregation, and command routing) from
# regressing silently. Bypass in an emergency with: git commit --no-verify
set -e

# Repo root = two levels up from scripts/hooks/.
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
TEST="$ROOT/tests/test_core.py"

# Never wedge a clone that doesn't have the test yet.
if [ ! -f "$TEST" ]; then
    exit 0
fi

# Prefer the project venv; fall back to system python3 (test is pure stdlib).
if [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
else
    PY=python3
fi

echo "pre-commit: running core and CLI contract tests..."
if ! (cd "$ROOT" && "$PY" -m unittest tests.test_core tests.test_cli_contract tests.test_platform); then
    echo "pre-commit: fast code gate FAILED — commit aborted." >&2
    echo "  Fix the regression, or deliberately update the corresponding contract test." >&2
    echo "  Bypass in an emergency with: git commit --no-verify" >&2
    exit 1
fi
